{
  "name": "regardin-construction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Regardin Construction website — static HTML/CSS/vanilla JS built with Vite.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/build-pages.mjs && vite",
    "prebuild": "node scripts/images.js && node scripts/build-og.mjs && node scripts/build-pages.mjs",
    "build": "vite build && node scripts/postbuild.js",
    "build:cpanel": "node scripts/build-target.mjs cpanel",
    "build:pages": "node scripts/build-target.mjs pages",
    "preview": "vite preview --port 4173 --strictPort",
    "package": "node scripts/package-cpanel.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint . && stylelint \"src/**/*.css\"",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.js",
    "check:banned": "node scripts/banned-content.js",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "qa:apache": "node scripts/qa-apache.mjs",
    "images": "node scripts/images.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "html-validate": "11.16.1",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0"
  }
}
