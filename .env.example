# Copy to .env for local work. Never commit real values — this repository is public.
# SITE_ENV=production switches off noindex, enables the HTTPS redirect and enforces the [CONFIRM] build gate.
SITE_ENV=preview

# Phase 5 enquiry backend (PHP on cPanel). On the server these live in a config file
# OUTSIDE public_html, never in git.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ENQUIRY_NOTIFY_TO=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
